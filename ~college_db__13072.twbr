      <column caption='Derived Department' datatype='string' name='[Calculation_0725738653859840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH([subject_code], &quot;CS&quot;) THEN &quot;Computer Science&quot;&#13;&#10;ELSEIF STARTSWITH([subject_code], &quot;EC&quot;) THEN &quot;Electronics&quot;&#13;&#10;ELSEIF STARTSWITH([subject_code], &quot;ME&quot;) THEN &quot;Mechanical&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
