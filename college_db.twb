      <column datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_0532499403706368]) - LOOKUP(ZN([Calculation_0532499403706368]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='True Student Average' datatype='real' name='[Calculation_0116608807878659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [name] : AVG([internal_marks] + [external_marks]) }' />
      </column>
      <column caption='Student-Staff Ratio' datatype='real' name='[Calculation_0116608828649476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([student_id]) / COUNTD([staff_id])' />
      </column>
      <column caption='Student Count' datatype='integer' name='[Calculation_0532499403706368]' role='measure' type='quantitative'>
